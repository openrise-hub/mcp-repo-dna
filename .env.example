# Output directory for generated skills.sh and rules.md
REPODNA_OUTPUT_DIR=./repodna

# Number of commits fetched for git history analysis
REPODNA_HISTORY_DEPTH=100

# Timeout in seconds for git clone operations
REPODNA_CLONE_TIMEOUT=120

# Maximum file size (in MB) sampled during analysis
REPODNA_MAX_FILE_SIZE_MB=1
