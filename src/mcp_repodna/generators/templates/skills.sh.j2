#!/usr/bin/env bash
# Generated by mcp-repodna from {{ dna.repository }}
# Generated at {{ dna.analyzed_at.strftime("%Y-%m-%d %H:%M:%S") }} UTC
# Overall confidence: {{ dna.confidence.value }}
#
# Executable engineering DNA checks for autonomous coding agents.
# Source this file and call the dna:* functions, or run the full
# preflight gate with: bash skills.sh
set -euo pipefail

dna:run() {
    local cmd="$1"
    shift
    echo "==> $cmd" "$@"
    "$cmd" "$@"
}

{%- if dna.git.commit_style == "conventional" %}

dna:commit() {
    local message="${1:?usage: dna:commit <subject>}"
    local pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'
    if ! [[ "$message" =~ $pattern ]]; then
        echo "error: commit subject must follow conventional commits" >&2
        echo "       example: feat: add retry logic" >&2
        return 1
    fi
    echo "ok: conventional commit subject"
}
{%- else %}

dna:commit() {
    echo "info: repository uses freeform commit subjects; no strict gate applied"
}
{%- endif %}

{%- if branch_prefixes %}

dna:branch() {
    local branch="${1:?usage: dna:branch <branch-name>}"
    local pattern='^({{ branch_prefixes | join("|") }})/'
    if ! [[ "$branch" =~ $pattern ]]; then
        echo "error: branch must start with one of: {{ branch_prefixes | join(", ") }}" >&2
        return 1
    fi
    echo "ok: branch naming follows repository conventions"
}
{%- else %}

dna:branch() {
    echo "info: no branch naming convention detected"
}
{%- endif %}

{%- if commands.lint %}

dna:lint() {
{% for command in commands.lint %}    dna:run {{ command }}
{% endfor %}}
{%- else %}

dna:lint() { echo "info: no linter detected" }
{%- endif %}

{%- if commands.format %}

dna:format() {
{% for command in commands.format %}    dna:run {{ command }}
{% endfor %}}
{%- else %}

dna:format() { echo "info: no formatter detected" }
{%- endif %}

{%- if commands.typecheck %}

dna:typecheck() {
{% for command in commands.typecheck %}    dna:run {{ command }}
{% endfor %}}
{%- else %}

dna:typecheck() { echo "info: no type checker detected" }
{%- endif %}

{%- if commands.test %}

dna:test() {
{% for command in commands.test %}    dna:run {{ command }}
{% endfor %}}
{%- else %}

dna:test() { echo "info: no test runner detected" }
{%- endif %}

{%- if dna.tooling.pre_commit_hooks %}

dna:install-hooks() {
    dna:run pre-commit install
}
{%- else %}

dna:install-hooks() { echo "info: no pre-commit configuration detected" }
{%- endif %}

dna:preflight() {
    echo "== preflight checks for {{ dna.repository }}"
    dna:lint
    dna:format
    dna:typecheck
    dna:test
    echo "preflight passed"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    dna:preflight "$@"
fi
